{
  "appId": "com.metatron.caricostudio.desktop",
  "productName": "METATRON CaricoStudio",
  "copyright": "METATRON CaricoStudio",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "desktop-app/main.cjs",
    "desktop-app/preload.cjs",
    "os-installer/**/*",
    "public/pwa-512x512.png",
    "package.json",
    "!dist/CaricoStudio_Desktop_Windows.html",
    "!**/*.map"
  ],
  "asarUnpack": [
    "dist-electron/**/*",
    "dist/**/*",
    "os-installer/**/*",
    "node_modules/pdfkit/**/*"
  ],
  "extraMetadata": {
    "main": "desktop-app/main.cjs"
  },
  "win": {
    "icon": "public/pwa-512x512.png",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "METATRON CaricoStudio",
    "artifactName": "METATRON-CaricoStudio-Setup-${version}.exe"
  },
  "portable": {
    "artifactName": "METATRON-CaricoStudio-Portable-${version}.exe"
  },
  "mac": {
    "icon": "public/pwa-512x512.png",
    "category": "public.app-category.business",
    "target": [
      {
        "target": "dmg",
        "arch": ["x64", "arm64"]
      }
    ],
    "artifactName": "METATRON-CaricoStudio-${version}-${arch}.dmg"
  },
  "linux": {
    "icon": "public/pwa-512x512.png",
    "category": "Office",
    "target": ["AppImage", "deb"],
    "artifactName": "METATRON-CaricoStudio-${version}-${arch}.${ext}"
  }
}
