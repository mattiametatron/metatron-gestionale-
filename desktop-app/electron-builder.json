{
  "appId": "com.metatron.caricostudio.desktop",
  "productName": "METATRON CaricoStudio",
  "copyright": "METATRON CaricoStudio",
  "directories": {
    "output": "release"
  },
  "files": [
    "desktop-app/main.cjs",
    "desktop-app/preload.cjs",
    "public/pwa-512x512.png",
    "package.json",
    "!**/*.map"
  ],
  "extraResources": [
    {
      "from": "dist",
      "to": "dist",
      "filter": [
        "**/*",
        "!CaricoStudio_Desktop_Windows.html",
        "!**/*.map"
      ]
    },
    {
      "from": "dist-electron",
      "to": "dist-electron"
    },
    {
      "from": "desktop-app/update-config.json",
      "to": "desktop-app/update-config.json"
    },
    {
      "from": "os-installer",
      "to": "os-installer"
    }
  ],
  "extraMetadata": {
    "main": "desktop-app/main.cjs"
  },
  "generateUpdatesFilesForAllChannels": true,
  "publish": [
    {
      "provider": "github",
      "releaseType": "release"
    }
  ],
  "win": {
    "icon": "public/pwa-512x512.png",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "METATRON CaricoStudio",
    "artifactName": "METATRON-CaricoStudio-Setup-${version}.exe"
  },
  "mac": {
    "icon": "public/pwa-512x512.png",
    "category": "public.app-category.business",
    "target": [
      {
        "target": "dmg",
        "arch": ["x64", "arm64"]
      }
    ],
    "artifactName": "METATRON-CaricoStudio-${version}-${arch}.dmg"
  },
  "linux": {
    "icon": "public/pwa-512x512.png",
    "category": "Office",
    "target": ["AppImage", "deb"],
    "artifactName": "METATRON-CaricoStudio-${version}-${arch}.${ext}"
  }
}
